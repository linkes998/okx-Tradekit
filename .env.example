# ============================================================
# RH Trencher — Jupiter Live Trader Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- Jupiter API Key (RECOMMENDED) ---
# Get one free at https://portal.jup.ag
# Without a key, api.jup.ag works at 60 rpm default.
# With a key you get higher rate limits + priority queue.
JUPITER_API_KEY=your_jupiter_api_key_here

# --- Your Fee Wallet (MANDATORY for platform fees) ---
# This is the Solana wallet that receives platform fees.
# Every trade goes through Jupiter; fees are auto-deducted and
# sent to this wallet's SPL Token ATA (derived automatically).
# Can be any wallet you own — no registration required.
RH_FEE_WALLET=vines1vzrYbzLMRdu58ou5XTby4qAqVRLmqo36NKPTg

# --- Fee Configuration ---
# platformFeeBps = fee basis points (1 bps = 0.01%, max 100 = 1%)
# 25  = 0.25% (conservative, good for initial launch)
# 50  = 0.5%  (standard for memecoin tools)
# 100 = 1.0%  (aggressive — only if you provide significant value)
RH_FEE_BPS=50

# Optional: force fee to be collected in a specific mint (e.g. USDC).
# If unset, Jupiter uses the swap's output mint.
RH_FEE_MINT=

# --- Executor Behavior ---
# Jupiter quote endpoint (default: api.jup.ag, no key needed for 60 rpm)
JUPITER_QUOTE_URL=
JUPITER_SWAP_URL=
